# ==============================================================================
# Multi-Tenant QR Menu & Ordering SaaS Environment Variables
# ==============================================================================

# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Razorpay Payment Gateway Credentials
# Found in Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Site URL for QR code generation ({SITE_URL}/r/{slug}?table={table_number})
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Demo Owner Credentials (for seed script and owner operations)
DEMO_OWNER_EMAIL="owner@spicegarden.demo"
DEMO_OWNER_PASSWORD="demo123456"
